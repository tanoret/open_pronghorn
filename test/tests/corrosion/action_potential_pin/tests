[Tests]
  design = 'CorrosionPlatingAction.md ButlerVolmerBC.md CorrosionRateAux.md'
  issues = '#4'

  [default_metal_tracks_nonzero_salt_pin]
    type = RunApp
    input = nonzero_pin.i
    check_input = true
    expect_out = '(?s)salt_potential_pin=0.0375 V; default_metal_potential=0.1375 V; seed_metal_minus_salt=0.1 V'
    requirement = 'When the salt-potential gauge is pinned to a nonzero value, the finite-element '
                  'CorrosionPlating Action shall add that pin to its generated default absolute '
                  'metal potential so the seeded metal-minus-salt overpotential is unchanged.'
  []

  [custom_metal_potential_is_absolute]
    type = RunApp
    input = nonzero_pin.i
    check_input = true
    cli_args = 'CorrosionPlating/applied_potential=0.25'
    expect_out = '(?s)salt_potential_pin=0.0375 V; external_metal_potential=custom_absolute \(not shifted by the Action\); seed_metal_minus_salt=0.1 V'
    requirement = 'An explicitly supplied salt-only external-metal potential functor shall remain '
                  'a user-owned absolute potential and shall not receive the automatic salt-pin '
                  'gauge offset.'
  []

  [reject_overflowing_default_metal_potential]
    type = RunException
    input = nonzero_pin.i
    check_input = true
    cli_args = 'CorrosionPlating/applied_overpotential=1e308 '
               'CorrosionPlating/pin_potential_value=1e308'
    expect_err = 'pin_potential_value.*sum with applied_overpotential must be finite'
    requirement = 'The finite-element CorrosionPlating Action shall reject finite salt-gauge and '
                  'overpotential inputs whose sum would overflow the generated absolute metal '
                  'potential.'
  []
[]
