  design = 'NTPLinearFVViscousStressCorrection.md NTPChannelVelocity.md kEpsilonTKESourceSink.md'
  issues = '#000'
  [channel_turbulence_rz]
    type = CSVDiff
    input = '../../../../examples/ntp_tutorial/02_element/element_simple_rz.i'
    cli_args = '../../../../examples/ntp_tutorial/common/channel_turbulence.i
                ../../../../examples/ntp_tutorial/common/channel_turbulence_rz.i
                nz=6 n_ch=4 n_pl=4 simple_fixed_point=3 simple_iterations=200 Outputs/exodus=false
                Outputs/file_base=channel_turbulence_rz_out'
