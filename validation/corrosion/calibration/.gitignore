# Recalibration products are intentionally regenerated, not versioned. The
# frozen benchmark used by tests lives in reference/ and results/advanced/.
generated/
figures/
__pycache__/
*.py[cod]
.pytest_cache/

# MSTDB-TC is external, permission-controlled input and must never be committed.
*MSTDB-TC*.dat
MSTDB-TC/
Thermochimica/

# The repository root ignores generic CSV, JSON, and TXT outputs. These are
# curated inputs/reference artifacts, so keep their exceptions local.
!requirements.txt
!advanced_provenance.json
!data/parameters.json
!data/targets.csv
!data/workbook_exports/*.csv
!reference/*.csv
!reference/*.json
!results/advanced/*.csv
!results/advanced/*.json
