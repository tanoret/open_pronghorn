[Tests]
  design = 'MoltenSaltRadiolysisAction.md MSRReaction.md'
  issues = '#000'
  # Solvated-electron decay by Cr(II)/Cr(III) capture vs the digitized Iwamatsu et al. PCCP 2026
  # transient-absorption traces. The absorbance is proportional to [e_sol] up to a scale factor;
  # the validation bounds the scale-free relative RMSE between the modeled decay and each trace.
  [cr2_1mM]
    type = RunApp
    input = cr_pulse.i
    cli_args = 'Cr_II_initial=0.99 Outputs/file_base=cr2_1mM'
    max_time = 300
    validation_test = 'cr_vnv.py'
    validation_data_file = 'data/absorbance1mMCr2.csv'
    validation_model_file = 'cr2_1mM.csv'
    validation_upper_bound = 0.20
    requirement = 'The system shall reproduce the e_sol decay by 1 mM Cr(II) capture.'
  []
